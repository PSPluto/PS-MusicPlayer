{
  "name": "transparentmusicplayer",
  "version": "1.0.0",
  "description": "Transparent Music Player",
  "main": "main.js",
  "build": {
    "appId": "com.transparentmusicplayer.app",
    "productName": "MusicPlayer",
    "files": [
      "**/*",
      "!**/debug_and_test/**",
      "!**/_Trash/**",
      "!**/*.bak",
      "!**/backups/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "scripts": {
    "test": "node test/syntax.test.js && node test/track_sort.test.js && node test/title_tags.test.js && node test/equalizer.test.js && node test/dropdown_backdrop.test.js",
    "start": "node launch.js",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.1.4",
    "music-metadata": "^11.12.3"
  }
}